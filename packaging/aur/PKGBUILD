_pkgname=filegram
pkgname=filegram-bin
pkgver=0.2.12
pkgrel=1
pkgdesc='Disk space analyzer with an interactive treemap'
arch=('x86_64')
url='https://github.com/filegram/filegram-desktop'
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('filegram')
conflicts=('filegram')
source=(
  "$pkgname-$pkgver.zip::https://github.com/filegram/filegram-desktop/releases/download/v$pkgver/filegram-linux-x86_64.zip"
  "filegram-$pkgver.desktop::https://raw.githubusercontent.com/filegram/filegram-desktop/v$pkgver/packaging/linux/filegram.desktop"
  "filegram-$pkgver.svg::https://raw.githubusercontent.com/filegram/filegram-desktop/v$pkgver/assets/icon/icon.svg"
  "filegram-$pkgver-LICENSE::https://raw.githubusercontent.com/filegram/filegram-desktop/v$pkgver/LICENSE"
)
sha256sums=(
  'c53042d183941398cb2f92d9ef1522e4fad455baea7a2637f2e2a6d64936563a'
  'cf92853a5d29a9283a3e793c8f210df51e65e91a4d5a29d8e27c0f9ec3bde935'
  '18394b7cc664255d02eccee349fd4eead45654a7a3fe64c37b82037aa1e0af96'
  'bcff0ea4324cc65a9f91086b6d79a944460f6ede95ad2621c9c5b8261fa6a1a6'
)

package() {
  install -Dm755 filegram-linux-x86_64 "$pkgdir/usr/bin/filegram"
  install -Dm644 "filegram-$pkgver.desktop" "$pkgdir/usr/share/applications/filegram.desktop"
  install -Dm644 "filegram-$pkgver.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/filegram.svg"
  install -Dm644 "filegram-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
